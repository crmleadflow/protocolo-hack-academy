# MongoDB Atlas — base de datos PROPIA de Protocolo Hack.
# NUNCA debe apuntar a la base del CRM (Lead Flow CRM usa su propia base, separada).
MONGODB_URI=
MONGODB_DB=protocolo_hack

# Auth.js (NextAuth v5) — login propio, sin SSO con el CRM.
# Generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Resend — envío del magic link por correo (sin contraseñas).
AUTH_RESEND_KEY=
EMAIL_FROM="Protocolo Hack <academia@leadflowneurosophia.io>"

# Stripe — pagos internacionales.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Wompi — pagos Colombia. Integración dejada armada en lib/payments/wompi.ts
# pero INCOMPLETA (pendiente de completar, ver CLAUDE.md "Pendientes").
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

# ── Puente hacia Lead Flow CRM (ver lib/crm/bridge.ts) ──────────────────────
# Token de la integración "landing externa" llamada "Protocolo Hack".
# Lo genera Hector desde la UI del CRM, logueado en su tenant (no se puede
# generar desde aquí). Mientras esté vacío, el envío al CRM falla en
# silencio y queda en la bandeja crm_outbox para reintentar después — no
# bloquea el resto del producto.
LEADFLOW_CRM_WEBHOOK_TOKEN=
LEADFLOW_CRM_BASE_URL=https://app.leadflowneurosophia.io

# URL pública de agenda de llamadas del CRM (botón "Agendar una llamada").
# Esa página del CRM ya crea el lead sola al reservar — no hace falta llamar
# a ninguna API desde aquí para ese caso.
LEADFLOW_CRM_BOOKING_URL=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Correos que entran como super_admin desde su primer login (separados por coma).
# Poné aquí el correo de Hector antes de invitar a nadie más.
SUPER_ADMIN_EMAILS=

